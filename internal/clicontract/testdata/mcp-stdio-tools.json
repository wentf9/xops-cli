  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "readOnlyHint": false
    },
    "description": "Create a process-owned SSH TCP tunnel over stdio only (-L or -R). Returns after listening; running does not prove destination reachability. Local means the xops MCP process machine. The tunnel survives this call until stopped, expired, disconnected, or MCP exits. A failed state is terminal; use a new requestID after fixing the cause.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "listenHost": {
          "description": "IP literal or localhost; defaults to 127.0.0.1. Remote exposure is controlled by sshd GatewayPorts.",
          "type": "string"
        },
        "listenPort": {
          "description": "Listening TCP port, 0 to 65535. Zero requests an automatically allocated port.",
          "type": "integer"
        },
        "mode": {
          "description": "local (-L): listen on the MCP process machine and connect from the SSH node. remote (-R): listen on the SSH node and connect from the MCP process machine. No dynamic forwarding.",
          "type": "string"
        },
        "nodeID": {
          "description": "Managed SSH node ID or alias, including canonical openssh:host IDs returned by tunnel tools.",
          "type": "string"
        },
        "requestID": {
          "description": "Client-generated idempotency key. Reuse the same key and parameters to recover a lost response; use a new key for a new tunnel.",
          "type": "string"
        },
        "targetHost": {
          "description": "Destination host name or unbracketed IP literal, interpreted on the destination side of the tunnel.",
          "type": "string"
        },
        "targetPort": {
          "description": "Destination TCP port, 1 to 65535.",
          "type": "integer"
        },
        "ttlSeconds": {
          "description": "Lifetime after startup, 1 to 86400 seconds; default 3600. Not renewed by queries or retries.",
          "type": "integer"
        }
      },
      "required": [
        "requestID",
        "nodeID",
        "mode",
        "listenPort",
        "targetHost",
        "targetPort"
      ],
      "type": "object"
    },
